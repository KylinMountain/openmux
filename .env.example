# OpenMux Provider API Keys
# 只需填入你拥有的平台 Key，不用的留空或删除即可
# 大部分平台注册即送免费额度

# 智谱 GLM (多款免费模型) - https://open.bigmodel.cn
ZHIPU_API_KEY=your-zhipu-api-key

# 硅基流动 SiliconFlow (多款免费模型) - https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=your-siliconflow-api-key

# OpenRouter (约 30 款免费模型) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# 魔搭 ModelScope (免费，2000 次/天) - https://modelscope.cn/my/myaccesstoken
MODELSCOPE_API_KEY=your-modelscope-access-token

# 阿里云百炼 DashScope - https://dashscope.console.aliyun.com
ALIYUN_API_KEY=your-aliyun-api-key

# DeepSeek - https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key

# 美团 LongCat (公测免费) - https://longcat.chat/platform
LONGCAT_API_KEY=your-longcat-api-key

# 火山引擎/豆包 (新用户每模型 50 万 tokens) - https://www.volcengine.com
VOLCENGINE_API_KEY=your-volcengine-api-key
